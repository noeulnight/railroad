generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TrainDirection {
  UP
  DOWN
}

enum TrainEventType {
  CREATED
  UPDATED
  REMOVED
}

model Station {
  id        String   @id @default(cuid())
  name      String   @unique
  grade     Int?
  latitude  Float?
  longitude Float?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stations")
}

model TrainEvent {
  id                 String          @id @default(cuid())
  occurredAt         DateTime        @map("occurred_at")
  eventType          TrainEventType  @map("event_type")
  trainId            String          @map("train_id")
  type               String?
  direction          TrainDirection?
  delayMinutes       Int?            @map("delay_minutes")
  previousLatitude   Float?          @map("previous_latitude")
  previousLongitude  Float?          @map("previous_longitude")
  latitude           Float?
  longitude          Float?
  currentStationName String?         @map("current_station_name")
  nextStationName    String?         @map("next_station_name")

  @@index([occurredAt])
  @@index([trainId, occurredAt(sort: Desc)])
  @@map("train_events")
}
